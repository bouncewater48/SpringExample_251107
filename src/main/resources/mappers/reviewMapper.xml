<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.bounce.springexample.mybatis.repository.ReviewRepository">

    <select id="selectReview"
    resultType="com.bounce.springexample.mybatis.domain.Review">
        SELECT
            `id`
            , `store_id`
            , `menu`
            , `user_name`
            , `point`
            , `review`
            , `created_at`
            , `updated_at`
        FROM
            `new_review`
        WHERE
            `id` = #{id}
    </select>

    <!-- insert타입은 int 타입으로 고정되어있어서 resultType을 지정하려하면 되려 에러발생! -->
    <insert id="insertReview" parameterType="map">
        INSERT INTO
            `new_review`
        (
        `store_id`
        , `menu`
        , `user_name`
        , `point`
        , `review`
        )
        VALUE
        (
            #{storeId}
            , #{menu}
            , #{userName}
            , #{point}
            , #{review}
        )
    </insert>

    <insert id="insertReviewByObject"
    parameterType="com.bounce.springexample.mybatis.domain.Review">
        INSERT INTO
            `new_review`
        (
            `store_id`
            , `menu`
            , `user_name`
            , `point`
            , `review`
        )
        VALUE
        (
            #{storeId}
            , #{menu}
            , #{userName}
            , #{point}
            , #{review}
        )
    </insert>

</mapper>